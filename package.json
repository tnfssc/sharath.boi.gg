{
  "name": "tanstack-start-example-basic",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "cf-typegen": "wrangler types --env-interface Env",
    "ci": "bun run typecheck && bun run lint && bun run format",
    "deploy": "npm run build && wrangler deploy",
    "dev": "vite dev",
    "format": "eslint --fix . && prettier --write .",
    "lint": "eslint .",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.129.2",
    "@tanstack/react-router-devtools": "^1.129.2",
    "@tanstack/react-start": "^1.129.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.31.0",
    "eslint-plugin-perfectionist": "^4.15.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-packagejson": "^2.5.19",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.0-beta",
    "typescript-eslint": "^8.38.0",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "wrangler": "^4.27.0"
  },
  "trustedDependencies": [
    "@parcel/watcher"
  ]
}
